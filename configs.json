{
  "_comment": "Config for H100 40GB hypernerf dataset, no-mask (ignore_mask=true, motion-threshold freeze_background_motion for every scene regardless of whether mask/ exists). dyn_select_iter deliberately moved to AFTER the last anchor_refine (finest anchor resolution) instead of between refines, unlike configs.json/configs_nerf_ds.json/configs_dnerf.json: without mask supervision the Otsu split needs the cleanest motion signal available, and H100's 40GB (vs the 6GB RTX3060 that forced early freezing in those other configs) comfortably covers the ~2x bigger dense anchor-param tensor this implies (worst case ~hand scene, 1734 frames, M~290 anchors: well under 10GB).",
  "model": {
    "sh_degree": 3,
    "images": "images",
    "resolution": -1,
    "white_background": false,
    "data_device": "cuda",
    "eval": true,
    "load2gpu_on_the_fly": false
  },
  "optimization": {
    "iterations": 24000,
    "warm_up": 3000,
    "position_lr_init": 0.00016,
    "position_lr_final": 0.0000016,
    "position_lr_delay_mult": 0.01,
    "position_lr_max_steps": 24000,
    "feature_lr": 0.0025,
    "opacity_lr": 0.05,
    "scaling_lr": 0.001,
    "rotation_lr": 0.001,
    "percent_dense": 0.01,
    "lambda_dssim": 0.2,
    "densification_interval": 150,
    "opacity_reset_interval": 3000,
    "densify_from_iter": 500,
    "densify_until_iter": 14500,
    "densify_grad_threshold": 0.00055
  },
  "sparse_anchor": {
    "anchor_stride": 6,
    "temporal_window": 2,
    "knn_k": 40,
    "transport_order": 2,
    "consensus_sigma": 1.0,
    "no_fit_confidence": false,
    "wls_eps": 0.01,
    "coarse_levels": 2,
    "anchor_refine_iters": [5000, 7500],
    "dyn_select_iter": 9500,
    "dyn_w_min": 10.0,
    "ignore_mask": true,
    "motion_dyn_margin": 0.5,
    "motion_dyn_floor": 0.01,
    "knn_update_interval": 1500,
    "mask_vote_decay": 0.999,
    "epsilon": 0.0,
    "score_kappa_rot": 0.2,
    "score_kappa_scale": 0.2,
    "lambda_rigid": 0.3,
    "lambda_temporal": 0.05,
    "lambda_scale": 0.3,
    "motion_lr_init": 0.0009,
    "motion_rot_lr": 0.001,
    "motion_scale_lr": 0.001
  },
  "train": {
    "test_iterations": [8000, 16000, 24000],
    "save_iterations": [18000, 24000],
    "checkpoint_iterations": [5000, 10000, 15000, 20000]
  }
}
  